{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Driftpunkt addon.json, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slug",
    "version",
    "name",
    "description",
    "placement",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})\\.(?:0|[1-9][0-9]{0,5})$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "placement": {
      "enum": [
        "homepage",
        "customer_dashboard",
        "technician_dashboard"
      ]
    },
    "links": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?:/(?![/\\\\])|https://)"
          }
        }
      }
    }
  }
}
